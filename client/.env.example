# Base URL the frontend's API client (src/lib/api.ts) prefixes onto every
# request. "/api" (relative) routes through the Next.js proxy in
# next.config.ts, which forwards to BACKEND_ORIGIN below on the server side.
# This avoids the browser hitting CORS errors, since the existing backend
# (backend/src/app.ts) registers no CORS middleware and must not be modified.
#
# If the backend later adds CORS support, you can point this directly at the
# backend instead, e.g. NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=/api

# Server-side only (not exposed to the browser). Where the Next.js proxy
# forwards "/api/*" requests. Must match the backend's PORT (backend/.env).
BACKEND_ORIGIN=http://localhost:3000
